# SecureVote Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with production values

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=SecureVote API
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Security & Cryptography
# Secret key used for signing / session integrity (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_string_in_production
# 32-byte Base64-encoded key for AES-256-GCM application-level biometric template encryption
BIOMETRIC_ENCRYPTION_KEY=dGhpc19pc19hXzMyX2J5dGVfZHVtbXlfa2V5X2Zvcl9kZXY=
# Global salt for hashing voter identification numbers
ID_HASH_SALT=securevote_voter_id_salt_change_in_production

# Oracle Database Configuration (Thin Mode - No Oracle Client libraries required)
ORACLE_USER=securevote_app
ORACLE_PASSWORD=secure_oracle_password_here
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
# Optional: Connection pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1

# CORS Settings (frontend origin)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
